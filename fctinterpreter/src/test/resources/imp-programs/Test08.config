// `int x; x = 8; while ((x <= 10) && !(x <= 5)) { x = x + 1; }` -- the only one
// of the nine with a loop, and the only one needing `while-true` and `and`.
general {
    funcon-term:
      initialise-storing
      give(
        allocate-initialised-variable(integers, 0),
        sequential(
          assign(given, decimal-natural("8")),
          while-true(
            if-true-else(
              and(
                integer-is-less-or-equal(assigned(given), decimal-natural("10")),
                not(integer-is-less-or-equal(assigned(given), decimal-natural("5")))),
              true,
              false),
            assign(
              given,
              integer-add(assigned(given), decimal-natural("1")))),
          assigned(given)))
      ;
}

tests {
    result-term: 11;
}

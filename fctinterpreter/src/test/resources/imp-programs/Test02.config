// `int a,b,c ; {}` -- three declarations, none assigned. The 2016 term nested
// three `bind`s; here the locations are collected in a vector so each can be
// reached by index, because a nested `give` would rebind the name `given`.
general {
    funcon-term:
      initialise-storing
      give(
        vector(
          allocate-initialised-variable(integers, 0),
          allocate-initialised-variable(integers, 0),
          allocate-initialised-variable(integers, 0)),
        tuple(
          assigned(index(1, vector-elements(given))),
          assigned(index(2, vector-elements(given))),
          assigned(index(3, vector-elements(given)))))
      ;
}

tests {
    result-term: tuple(0, 0, 0);
}

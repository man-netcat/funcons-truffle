// `int x; if (false) {} else {x = 6/3;}`
general {
    funcon-term:
      initialise-storing
      give(
        allocate-initialised-variable(integers, 0),
        sequential(
          if-true-else(
            false,
            assign(given, decimal-natural("0")),
            assign(given, integer-divide(decimal-natural("6"), decimal-natural("3")))),
          assigned(given)))
      ;
}

tests {
    result-term: 2;
}

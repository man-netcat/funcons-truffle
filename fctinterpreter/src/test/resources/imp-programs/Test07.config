// `int x; x = 1; x = (x + 7) / 2;` -- the assignment reads the variable it
// overwrites, so this is the one that would notice `assigned` and `assign`
// disagreeing about a location.
general {
    funcon-term:
      initialise-storing
      give(
        allocate-initialised-variable(integers, 0),
        sequential(
          assign(given, decimal-natural("1")),
          assign(
            given,
            integer-divide(
              integer-add(assigned(given), decimal-natural("7")),
              decimal-natural("2"))),
          assigned(given)))
      ;
}

tests {
    result-term: 4;
}

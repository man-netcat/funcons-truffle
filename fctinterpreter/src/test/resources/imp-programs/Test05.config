// `int x; if (true) {x = 1+2;}`
general {
    funcon-term:
      initialise-storing
      give(
        allocate-initialised-variable(integers, 0),
        sequential(
          if-true-else(
            true,
            assign(given, integer-add(decimal-natural("1"), decimal-natural("2"))),
            assign(given, decimal-natural("0"))),
          assigned(given)))
      ;
}

tests {
    result-term: 3;
}

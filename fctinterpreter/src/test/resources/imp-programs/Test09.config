// `int x,y; x = -1; y = 2; x = y+x;` -- the only one with two variables, so it
// also exercises the vector-of-locations idiom. The 2016 term wrote the literal
// as `integer-negate(decimal-natural("1"))`, kept here so these programs still
// cover `decimal-natural`.
general {
    funcon-term:
      initialise-storing
      give(
        vector(
          allocate-initialised-variable(integers, 0),
          allocate-initialised-variable(integers, 0)),
        sequential(
          assign(index(1, vector-elements(given)), integer-negate(decimal-natural("1"))),
          assign(index(2, vector-elements(given)), decimal-natural("2")),
          assign(
            index(1, vector-elements(given)),
            integer-add(
              assigned(index(2, vector-elements(given))),
              assigned(index(1, vector-elements(given))))),
          tuple(
            assigned(index(1, vector-elements(given))),
            assigned(index(2, vector-elements(given))))))
      ;
}

tests {
    result-term: tuple(1, 2);
}
